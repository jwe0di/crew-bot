# Required for the Discord bot to connect.
DISCORD_TOKEN=

# Optional owner override. If omitted, config.py OWNER_ID is used.
OWNER_ID=

# Database and JSON settings paths. Defaults: crewbot.db and a sibling servers_settings.json.
DB_PATH=crewbot.db
JSON_CONFIG_PATH=

# AI provider selection: groq or openrouter. At least one provider key is needed for AI.
AI_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional compatibility alias. Used only for the provider selected by AI_PROVIDER.
AI_API_KEY=

# Optional comma-separated model fallback lists. If omitted, code defaults are used.
GROQ_MODELS=
OPENROUTER_MODELS=

# Optional Tavily web search. Without this key, AI web search is unavailable.
TAVILY_API_KEY=
# Tavily search depth. Code default: advanced.
TAVILY_SEARCH_DEPTH=advanced